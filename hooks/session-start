#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
SKILL_PATH="${PLUGIN_ROOT}/skills/search-with-call-graph-context/SKILL.md"
SKILL_CONTENT="$(cat "${SKILL_PATH}")"

escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "${s}"
}

SKILL_ESCAPED="$(escape_for_json "${SKILL_CONTENT}")"
SESSION_CONTEXT="<IMPORTANT>\nThis repository ships a tracegrep plugin.\n\nUse Claude Code's built-in Grep tool for repository search when appropriate. In this repo, Grep results may be followed by tracegrep call-graph annotations from a PostToolUse hook. Avoid raw Bash \`rg\`/\`grep\` commands when \`tg\` or Grep can answer the question.\n\nBelow is the full content of the \`search-with-call-graph-context\` skill:\n\n${SKILL_ESCAPED}\n</IMPORTANT>"

cat <<EOF
{
  "additional_context": "${SESSION_CONTEXT}",
  "hookSpecificOutput": {
    "hookEventName": "SessionStart",
    "additionalContext": "${SESSION_CONTEXT}"
  }
}
EOF
